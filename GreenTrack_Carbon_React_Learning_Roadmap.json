  "frontendArchitecture": {
    "framework": "React 19+ + TypeScript",
    "architecturePattern": "Feature-Based Modular Architecture",
    "modules": [
      "auth",
      "dashboard",
      "activities",
      "goals",
      "community",
      "reports",
      "organization",
      "department",
      "admin",
      "shared"
    ],
    "features": [
      "Functional Components",
      "React Hooks",
      "React Router",
      "TanStack Query for server state",
      "Redux Toolkit for cross-feature client state",
      "React Hook Form",
      "Lazy Loading",
      "Route Guards / Protected Routes",
      "HTTP Interceptors or API middleware",
      "Reusable Design System Components",
      "Accessibility (WCAG 2.1)",
      "Code Splitting"
    ],
    "stateManagement": {
      "serverState": [
        "Activities",
        "Dashboard Analytics",
        "Goals",
        "Reports",
        "Organization Analytics"
      ],
      "clientState": [
        "Authenticated User",
        "Selected Organization",
        "Selected Department",
        "UI Preferences",
        "Notifications"
      ]
    }
  },
  "backendArchitecture": {
    "framework": "Spring Boot 3",
    "layers": [
      "Controller",
      "Service",
      "Repository",
      "Database"
    ],
    "services": [
      "AuthenticationService",
      "ActivityService",
      "CarbonCalculationService",
      "DashboardService",
      "GoalService",
      "RecommendationService",
      "NotificationService",
      "ReportService",
      "OrganizationService",
      "DepartmentService",
      "AuthorizationService"
    ],
    "architectureStyle": "Modular Monolith initially; designed so high-scale modules can be extracted later."
  },
  "security": {
    "authentication": {
      "description": "Authentication answers 'Who are you?' and establishes the user's identity.",
      "mechanism": [
        "Email/password login",
        "JWT access token",
        "Refresh token",
        "Password encryption",
        "Email verification",
        "Optional SSO/OAuth2 as future enhancement"
      ]
    },
    "authorization": {
      "description": "Authorization answers 'What are you allowed to do?' based on tenant, role, department, and resource ownership.",
      "model": "Multi-tenant RBAC with resource-level ownership checks",
      "roles": [
        "INDIVIDUAL_USER",
        "FAMILY_ADMIN",
        "ORGANIZATION_EMPLOYEE",
        "DEPARTMENT_MANAGER",
        "SUSTAINABILITY_MANAGER",
        "PLATFORM_ADMIN"
      ],
      "examples": [
        "Individual users can view and manage only their own activities and goals.",
        "Family admins can manage their household members and shared household activities.",
        "Organization employees can manage their own activities and view organization features permitted to employees.",
        "Department managers can view metrics for their department but not other departments.",
        "Sustainability managers can view organization-wide analytics and manage organization sustainability goals.",
        "Platform admins can manage platform configuration and emission factors."
      ],
      "backend_enforcement": [
        "Spring Security",
        "JWT claims",
        "Role-based endpoint protection",
        "Organization/tenant checks",
        "Department-level access checks",
        "Resource ownership validation"
      ]
    }
  },
  "apiDesign": {
    "authentication": [
      "POST /api/auth/register",
      "POST /api/auth/login",
      "POST /api/auth/refresh-token",
      "POST /api/auth/verify-email",
      "POST /api/auth/forgot-password",
      "POST /api/auth/reset-password",
      "POST /api/auth/logout"
    ],
    "activities": [
      "POST /api/activities",
      "GET /api/activities",
      "PUT /api/activities/{id}",
      "DELETE /api/activities/{id}"
    ],
    "dashboard": [
      "GET /api/dashboard/summary",
      "GET /api/dashboard/trends"
    ],
    "goals": [
      "POST /api/goals",
      "GET /api/goals",
      "PUT /api/goals/{id}"
    ],
    "reports": [
      "GET /api/reports/monthly",
      "GET /api/reports/yearly"
    ],
    "organization": [
      "POST /api/organizations",
      "GET /api/organizations/{id}",
      "GET /api/organizations/{id}/departments",
      "POST /api/organizations/{id}/departments",
      "GET /api/organizations/{id}/analytics",
      "GET /api/departments/{id}/analytics"
    ]
  },
