    "carbonCalculationEngine": {
      "description": "Core business engine for calculating emissions.",
      "formula": "Emission = Activity Value × Emission Factor",
      "sampleFactors": {
        "petrolCar": 0.192,
        "bus": 0.105,
        "flight": 0.255,
        "electricity": 0.82
      }
    },
    "dashboard": {
