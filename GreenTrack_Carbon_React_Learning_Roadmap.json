{
  "project": {
    "name": "GreenTrack Carbon",
    "tagline": "A Sustainability and Carbon Footprint Tracking Platform",
    "category": "Environmental Sustainability",
    "technologyStack": {
      "frontend": "React 19+ + TypeScript",
      "backend": "Java 21 + Spring Boot 3",
      "database": "MongoDB",
      "authentication": "JWT + Spring Security",
      "realTimeCommunication": "WebSockets",
      "caching": "Redis (Phase 2 / optional)",
      "deployment": "Docker + GitHub Actions + AWS",
      "stateManagement": "Redux Toolkit + TanStack Query",
      "frontendUI": "React Router + React Hook Form + Material UI",
      "apiClient": "Fetch/Axios"
    }
  },
  "executiveSummary": {
    "problemStatement": "Most individuals are unaware of their carbon footprint and lack tools to measure, track, and reduce their environmental impact.",
    "solution": "GreenTrack Carbon enables users to calculate, monitor, and improve their sustainability metrics through carbon tracking, goal setting, analytics, and personalized recommendations.",
    "objectives": [
      "Measure carbon emissions",
      "Track environmental impact over time",
      "Encourage sustainable behavior",
      "Provide actionable recommendations",
      "Promote environmental awareness"
    ]
  },
  "userPersonas": [
    {
      "role": "Individual User",
      "description": "Tracks personal carbon footprint, goals, activities, and recommendations."
    },
    {
      "role": "Family Member",
      "description": "Tracks household activities and contributes to a shared family carbon footprint."
    },
    {
      "role": "Organization Employee",
      "description": "Logs work-related sustainability activities and participates in organization challenges."
    },
    {
      "role": "Sustainability Manager",
      "description": "Monitors organization-wide emissions, departments, goals, initiatives, and sustainability reports."
    },
    {
      "role": "Department Manager",
      "description": "Views sustainability metrics for their department and monitors department goals and participation."
    },
    {
      "role": "Platform Administrator",
      "description": "Manages platform configuration, users, organizations, emission factors, and system-level reporting."
    }
  ],
  "modules": {
